-- Migration from schema v9 to v10: error notebook. Every wrong practice/quiz answer is kept with its topic
-- and resurfaces on a spaced schedule (dueAt) until it has been answered right enough times (resolved).

CREATE TABLE StudyMistake (
    id TEXT NOT NULL PRIMARY KEY,
    notebookId TEXT NOT NULL,
    topic TEXT NOT NULL,
    question TEXT NOT NULL,
    correctAnswer TEXT NOT NULL,
    yourAnswer TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    reviewCount INTEGER NOT NULL DEFAULT 0,
    dueAt INTEGER NOT NULL,
    resolved INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_mistake_notebook ON StudyMistake(notebookId);
