CREATE TABLE JournalEntry (
    id TEXT NOT NULL PRIMARY KEY,
    createdAt INTEGER NOT NULL,
    content TEXT NOT NULL,
    mood INTEGER,
    attachmentUri TEXT
);

insertJournalEntry:
INSERT INTO JournalEntry(id, createdAt, content, mood, attachmentUri)
VALUES (?, ?, ?, ?, ?);

selectAllJournalEntries:
SELECT * FROM JournalEntry ORDER BY createdAt DESC;

deleteJournalEntry:
DELETE FROM JournalEntry WHERE id = ?;

-- goalType is the hierarchy LEVEL (Life Vision -> Long Term -> Domain -> Quarterly
-- -> Monthly -> Weekly); the existing `domain` column stays the category label
-- (Academic/Career/Health/Financial/Personal/Research/Gym/GATE/...) — the two are
-- orthogonal, so this reuses `domain` rather than folding both into one enum.
CREATE TABLE Goal (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    domain TEXT NOT NULL,
    targetDate INTEGER,
    createdAt INTEGER NOT NULL,
    progress REAL NOT NULL DEFAULT 0.0,
    isArchived INTEGER NOT NULL DEFAULT 0,
    goalType TEXT NOT NULL DEFAULT 'WEEKLY',
    parentGoalId TEXT REFERENCES Goal(id),
    priority INTEGER,
    estimatedEffort INTEGER,
    estimatedImpact INTEGER,
    aiImportanceScore REAL
);

CREATE INDEX idx_goal_parent ON Goal(parentGoalId);
CREATE INDEX idx_goal_type ON Goal(goalType);

insertGoal:
INSERT INTO Goal(
    id, title, domain, targetDate, createdAt, progress, isArchived,
    goalType, parentGoalId, priority, estimatedEffort, estimatedImpact, aiImportanceScore
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectActiveGoals:
SELECT * FROM Goal WHERE isArchived = 0 ORDER BY createdAt DESC;

selectRootGoals:
SELECT * FROM Goal WHERE isArchived = 0 AND parentGoalId IS NULL ORDER BY createdAt DESC;

selectChildGoals:
SELECT * FROM Goal WHERE isArchived = 0 AND parentGoalId = ? ORDER BY createdAt DESC;

selectGoalsByType:
SELECT * FROM Goal WHERE isArchived = 0 AND goalType = ? ORDER BY createdAt DESC;

selectGoalById:
SELECT * FROM Goal WHERE id = ?;

updateGoalProgress:
UPDATE Goal SET progress = ? WHERE id = ?;

archiveGoal:
UPDATE Goal SET isArchived = 1 WHERE id = ?;

CREATE TABLE Task (
    id TEXT NOT NULL PRIMARY KEY,
    goalId TEXT NOT NULL REFERENCES Goal(id),
    title TEXT NOT NULL,
    dueDate INTEGER,
    priority INTEGER,
    estimatedEffort INTEGER,
    estimatedImpact INTEGER,
    aiImportanceScore REAL,
    isDone INTEGER NOT NULL DEFAULT 0,
    completedAt INTEGER,
    createdAt INTEGER NOT NULL
);

CREATE INDEX idx_task_goal ON Task(goalId);

insertTask:
INSERT INTO Task(
    id, goalId, title, dueDate, priority, estimatedEffort, estimatedImpact,
    aiImportanceScore, isDone, completedAt, createdAt
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectTasksForGoal:
SELECT * FROM Task WHERE goalId = ? ORDER BY isDone, dueDate IS NULL, dueDate, createdAt DESC;

selectAllTasks:
SELECT * FROM Task;

selectOpenTasks:
SELECT * FROM Task WHERE isDone = 0 ORDER BY dueDate IS NULL, dueDate, createdAt DESC;

setTaskDone:
UPDATE Task SET isDone = ?, completedAt = ? WHERE id = ?;

deleteTask:
DELETE FROM Task WHERE id = ?;

CREATE TABLE DailyCheckIn (
    date TEXT NOT NULL PRIMARY KEY,
    mood INTEGER,
    energy INTEGER,
    sleepHours REAL,
    executedMission INTEGER NOT NULL DEFAULT 0
);

upsertDailyCheckIn:
INSERT OR REPLACE INTO DailyCheckIn(date, mood, energy, sleepHours, executedMission)
VALUES (?, ?, ?, ?, ?);

selectRecentCheckIns:
SELECT * FROM DailyCheckIn ORDER BY date DESC LIMIT ?;

CREATE TABLE FocusArea (
    name TEXT NOT NULL PRIMARY KEY
);

insertFocusArea:
INSERT OR IGNORE INTO FocusArea(name) VALUES (?);

deleteFocusArea:
DELETE FROM FocusArea WHERE name = ?;

selectFocusAreas:
SELECT * FROM FocusArea;

CREATE TABLE ScheduleSlot (
    id TEXT NOT NULL PRIMARY KEY,
    dayOfWeek INTEGER NOT NULL,
    timeLabel TEXT NOT NULL,
    activityLabel TEXT NOT NULL,
    domain TEXT NOT NULL
);

insertScheduleSlot:
INSERT INTO ScheduleSlot(id, dayOfWeek, timeLabel, activityLabel, domain)
VALUES (?, ?, ?, ?, ?);

selectAllScheduleSlots:
SELECT * FROM ScheduleSlot ORDER BY dayOfWeek, timeLabel;

updateScheduleSlotLabel:
UPDATE ScheduleSlot SET activityLabel = ? WHERE id = ?;

deleteAllScheduleSlots:
DELETE FROM ScheduleSlot;

CREATE TABLE UserProfile (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    heightCm REAL,
    weightKg REAL,
    age INTEGER,
    isMale INTEGER,
    activityLevel TEXT,
    bodyGoal TEXT
);

upsertUserProfile:
INSERT OR REPLACE INTO UserProfile(id, heightCm, weightKg, age, isMale, activityLevel, bodyGoal)
VALUES (1, ?, ?, ?, ?, ?, ?);

selectUserProfile:
SELECT * FROM UserProfile WHERE id = 1;

CREATE TABLE ResearchNote (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    note TEXT NOT NULL,
    status TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    attachmentUri TEXT
);

insertResearchNote:
INSERT INTO ResearchNote(id, title, note, status, createdAt, attachmentUri)
VALUES (?, ?, ?, ?, ?, ?);

selectAllResearchNotes:
SELECT * FROM ResearchNote ORDER BY createdAt DESC;

deleteResearchNote:
DELETE FROM ResearchNote WHERE id = ?;

-- A body-weight + optional progress-photo check-in, the "Strong/Hevy-style"
-- progress timeline that Gym was missing entirely (it only had a static
-- profile form before this). photoUri is a persisted-permission SAF URI,
-- not a copied file — see AttachmentPicker on the Android side.
CREATE TABLE BodyLog (
    id TEXT NOT NULL PRIMARY KEY,
    createdAt INTEGER NOT NULL,
    weightKg REAL,
    photoUri TEXT,
    note TEXT
);

insertBodyLog:
INSERT INTO BodyLog(id, createdAt, weightKg, photoUri, note)
VALUES (?, ?, ?, ?, ?);

selectAllBodyLogs:
SELECT * FROM BodyLog ORDER BY createdAt DESC;

deleteBodyLog:
DELETE FROM BodyLog WHERE id = ?;

-- Personalization: explicit user choices (key/value) + implicit feedback log.
CREATE TABLE Preference (
    prefKey TEXT NOT NULL PRIMARY KEY,
    prefValue TEXT NOT NULL
);

upsertPreference:
INSERT OR REPLACE INTO Preference(prefKey, prefValue) VALUES (?, ?);

selectAllPreferences:
SELECT * FROM Preference;

CREATE TABLE BehaviorEvent (
    id TEXT NOT NULL PRIMARY KEY,
    createdAt INTEGER NOT NULL,
    type TEXT NOT NULL,
    domain TEXT,
    hourOfDay INTEGER NOT NULL
);

insertBehaviorEvent:
INSERT INTO BehaviorEvent(id, createdAt, type, domain, hourOfDay) VALUES (?, ?, ?, ?, ?);

selectRecentBehaviorEvents:
SELECT * FROM BehaviorEvent ORDER BY createdAt DESC LIMIT ?;

deleteAllBehaviorEvents:
DELETE FROM BehaviorEvent;

-- Study Hub
CREATE TABLE Notebook (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    examNotes TEXT
);

updateNotebookExamNotes:
UPDATE Notebook SET examNotes = ? WHERE id = ?;

insertNotebook:
INSERT INTO Notebook(id, title, createdAt) VALUES (?, ?, ?);

selectAllNotebooks:
SELECT * FROM Notebook ORDER BY createdAt DESC;

deleteNotebook:
DELETE FROM Notebook WHERE id = ?;

CREATE TABLE StudySource (
    id TEXT NOT NULL PRIMARY KEY,
    notebookId TEXT NOT NULL REFERENCES Notebook(id),
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    url TEXT,
    mediaUri TEXT,
    transcript TEXT
);

CREATE INDEX idx_source_notebook ON StudySource(notebookId);

insertStudySource:
INSERT INTO StudySource(id, notebookId, title, content, createdAt, url, mediaUri, transcript) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectSourceStorage:
SELECT notebookId, COUNT(*) AS sourceCount, SUM(LENGTH(content)) AS chars FROM StudySource GROUP BY notebookId;

selectSourcesForNotebook:
SELECT * FROM StudySource WHERE notebookId = ? ORDER BY createdAt;

deleteStudySource:
DELETE FROM StudySource WHERE id = ?;

deleteSourcesForNotebook:
DELETE FROM StudySource WHERE notebookId = ?;

CREATE TABLE Flashcard (
    id TEXT NOT NULL PRIMARY KEY,
    notebookId TEXT NOT NULL REFERENCES Notebook(id),
    sourceId TEXT,
    front TEXT NOT NULL,
    back TEXT NOT NULL,
    ease REAL NOT NULL DEFAULT 2.5,
    intervalDays INTEGER NOT NULL DEFAULT 0,
    repetitions INTEGER NOT NULL DEFAULT 0,
    dueAt INTEGER NOT NULL,
    createdAt INTEGER NOT NULL
);

CREATE INDEX idx_flashcard_notebook ON Flashcard(notebookId);

selectCardCounts:
SELECT notebookId, COUNT(*) AS cardCount FROM Flashcard GROUP BY notebookId;

insertFlashcard:
INSERT INTO Flashcard(id, notebookId, sourceId, front, back, ease, intervalDays, repetitions, dueAt, createdAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectFlashcardsForNotebook:
SELECT * FROM Flashcard WHERE notebookId = ? ORDER BY dueAt;

updateFlashcardSchedule:
UPDATE Flashcard SET ease = ?, intervalDays = ?, repetitions = ?, dueAt = ? WHERE id = ?;

deleteFlashcardsForNotebook:
DELETE FROM Flashcard WHERE notebookId = ?;

deleteFlashcardsForSource:
DELETE FROM Flashcard WHERE sourceId = ?;

-- Routines: recurring daily habits / fixed commitments, plus their completion log.
CREATE TABLE Routine (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    domain TEXT NOT NULL,
    minutes INTEGER NOT NULL,
    daysMask INTEGER NOT NULL DEFAULT 127,
    fixedStartMinute INTEGER,
    createdAt INTEGER NOT NULL,
    archived INTEGER NOT NULL DEFAULT 0
);

insertRoutine:
INSERT INTO Routine(id, title, domain, minutes, daysMask, fixedStartMinute, createdAt, archived)
VALUES (?, ?, ?, ?, ?, ?, ?, 0);

selectActiveRoutines:
SELECT * FROM Routine WHERE archived = 0 ORDER BY createdAt;

archiveRoutine:
UPDATE Routine SET archived = 1 WHERE id = ?;

CREATE TABLE RoutineLog (
    routineId TEXT NOT NULL REFERENCES Routine(id),
    date TEXT NOT NULL,
    completedAt INTEGER,
    PRIMARY KEY (routineId, date)
);

insertRoutineLog:
INSERT OR IGNORE INTO RoutineLog(routineId, date, completedAt) VALUES (?, ?, ?);

deleteRoutineLog:
DELETE FROM RoutineLog WHERE routineId = ? AND date = ?;

selectRoutineLogsSince:
SELECT * FROM RoutineLog WHERE date >= ?;

selectRoutineLogDates:
SELECT DISTINCT date FROM RoutineLog;
